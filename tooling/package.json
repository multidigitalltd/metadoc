{
  "name": "metadoc-theme-build",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind v4 build pipeline for the Metadoc WordPress theme",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ../assets/css/app.min.css --minify",
    "watch": "tailwindcss -i ./input.css -o ../assets/css/app.min.css --watch",
    "images": "node convert-images.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.0"
  }
}
